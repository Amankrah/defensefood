# UN Comtrade API keys — https://uncomtrade.org/docs/subscriptions/
# Copy to backend/script/.env (gitignored) and fill in your keys.

# Recommended: multiple keys for automatic rotation when one hits daily quota (HTTP 403)
COMTRADE_SUBSCRIPTION_KEYS=your_first_key,your_second_key,your_third_key

# Legacy: single key (still works; combine with KEYS if you use both)
# COMTRADE_SUBSCRIPTION_KEY=your_subscription_key_here
